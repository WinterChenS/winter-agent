# ── LLM Configuration ──────────────────────────────────────────────
API_KEY=sk-your-api-key-here
BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-flash

# ── LangSmith Observability (optional) ─────────────────────────────
# LANGCHAIN_API_KEY=lsv2_pt_your_key_here
# LANGCHAIN_PROJECT=winter-agent

# ── PostgreSQL (LangGraph checkpoint + user auth) ──────────────────
POSTGRES_URI=postgresql://app_user:your_password@postgres:5432/winter-agent

# ── Tavily Search API ──────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key-here

# ── Agent Guard Settings ───────────────────────────────────────────
MAX_CONSECUTIVE_SEARCH_CALLS=10
MAX_ITERATIONS=20
PYTHONUNBUFFERED=1
