# ── LLM Configuration ──────────────────────────────────────────────
API_KEY=sk-your-api-key-here
BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-flash

# ── LangSmith Observability (optional) ─────────────────────────────
# LANGCHAIN_API_KEY=lsv2_pt_your_key_here
# LANGCHAIN_PROJECT=winter-agent

# ── PostgreSQL ────────────────────────────────────────────────────
# Docker Compose uses POSTGRES_USER/PASSWORD/DB to construct the URI.
# For local dev without Docker, set POSTGRES_URI directly:
# POSTGRES_URI=postgresql://app_user:your_password@localhost:5432/winter-agent
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=winter-agent

# ── Tavily Search API ──────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key-here

# ── Domain & TLS ──────────────────────────────────────────────────
DOMAIN=your-domain.com
ACME_EMAIL=admin@your-domain.com

# ── Agent Guard Settings ───────────────────────────────────────────
MAX_CONSECUTIVE_SEARCH_CALLS=10
MAX_ITERATIONS=20
PYTHONUNBUFFERED=1
